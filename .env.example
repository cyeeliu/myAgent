# API Key (required)
# 从 OpenAI 控制台获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Model ID (required)
MODEL_ID=gpt-4o

# Fallback model (optional). Switched to after consecutive 529/overloaded errors.
# Can also be set at runtime via the 模型 panel (persisted to .agents/model.json).
# FALLBACK_MODEL_ID=gpt-4o-mini

# Base URL (optional, for OpenAI-compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Database (optional). Session history persists here across restarts.
# In docker compose this is set automatically (points at the `db` service).
# For local dev without docker, run a postgres on localhost or leave unset
# to fall back to in-memory-only (history lost on restart).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myagent

# Redis (optional). Live event stream (hot replay, 24h TTL). In docker compose
# this is set automatically. Unset → in-process queue+deque (events lost on
# restart, but Postgres history still replays at message granularity).
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
#  OpenAI-compatible providers
#
#  Provider         MODEL_ID              SWE-bench  TB2     Base URL
#  ---------------  --------------------  ---------  ------  -------------------
#  OpenAI           gpt-4o                79.6%      59.1%   (default)
#  MiniMax          MiniMax-M2.5          80.2%        -     see below
#  GLM (Zhipu)      glm-5                77.8%        -     see below
#  Kimi (Moonshot)  kimi-k2.5            76.8%        -     see below
#  DeepSeek         deepseek-chat        73.0%        -     see below
#                   (V3.2)
#
#  SWE-bench = SWE-bench Verified (Feb 2026)
#  TB2       = Terminal-Bench 2.0 (Feb 2026)
# =============================================================================

# ---- International ----

# MiniMax          https://www.minimax.io
# OPENAI_BASE_URL=https://api.minimax.io/v1
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://z.ai
# OPENAI_BASE_URL=https://api.z.ai/api/openai
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.ai
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# MODEL_ID=kimi-k2.5

# DeepSeek         https://platform.deepseek.com
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat

# ---- China mainland ----

# MiniMax          https://platform.minimax.io
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# MODEL_ID=MiniMax-M2.5

# GLM (Zhipu)      https://open.bigmodel.cn
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/openai
# MODEL_ID=glm-5

# Kimi (Moonshot)  https://platform.moonshot.cn
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# MODEL_ID=kimi-k2.5

# DeepSeek (no regional split, same endpoint globally)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat

# Bash sandbox (bubblewrap). "1" force-on, "0" force-off, unset = auto (on when
# bwrap is present and the session workdir != repo root, i.e. gateway per-session
# mode). When on, bash can only see the session workdir; the agent's own source,
# .env, .git are invisible. See agent_core/sandbox.py.
# SANDBOX=1

# Conversation-flow debug logging in the gateway (agent_gateway/debug.py).
# 1/true/yes/on to enable; off otherwise. Covers WS connect, req/res, drain
# (replay/live), history.get, chat.send, worker→pipe emits, turn lifecycle.
# View with: docker compose logs gateway | grep DBG
AGENT_DEBUG=0
